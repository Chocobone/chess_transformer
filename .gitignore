# 파이썬
__pycache__/
*.pyc
.pytest_cache/

# 생성 데이터·학습 산출물 (git에 올리지 않는다)
/data/
/runs/
/checkpoints/

# 베이스 모델 체크포인트 (download.sh로 받는다)
base_model/*/
base_model/*.zip
base_model/*.pt
base_model/*.npz

# GPU 서버 설정 (서버마다 다르다. gpu_train/site.env.example을 복사해 채운다)
gpu_train/site.env

# Hugging Face에서 입력을 받을 때 저장소 루트에 생기는 메타데이터 (gpu_train/fetch_inputs.sh)
/.cache/huggingface/
