# GPU 서버 설정. 이 파일을 gpu_train/site.env로 복사한 뒤 빈칸을 채운다 (site.env는 git 제외).
#   cp gpu_train/site.env.example gpu_train/site.env
# bash가 source하는 파일이다. "=" 앞뒤에 공백을 넣지 않는다. 빈 값은 그대로 비워 둔다.

# ── 경로 ─────────────────────────────────────────────
# 서버의 저장소 경로(절대 경로). 계산 노드에서도 같은 경로로 보여야 한다.
#   확인: 계산 노드에서 ls 해 본다 (srun --pty ls <경로>, 또는 smoke 작업 기록의 호스트·경로)
REPO_DIR=
# conda 초기화 스크립트. Miniconda 설치 경로 아래 etc/profile.d/conda.sh
#   확인: conda info --base  → <base>/etc/profile.d/conda.sh
CONDA_SH=
# 학습용 conda 환경 이름
CONDA_ENV=chess-train

# ── torch ────────────────────────────────────────────
# 비우면 PyPI 기본 휠(CUDA 런타임 포함)을 설치한다.
# 서버 드라이버가 오래되어 기본 휠이 안 돌면 https://download.pytorch.org/whl/cuXXX 로 맞춘다.
#   확인: 계산 노드에서 nvidia-smi  (오른쪽 위 "CUDA Version"이 드라이버가 지원하는 최대 버전)
TORCH_INDEX_URL=

# ── Slurm (비운 항목은 sbatch 옵션을 붙이지 않는다) ─────────
# 파티션 이름.             확인: sinfo -s
SBATCH_PARTITION=
# 계정(account).           확인: sacctmgr -n show assoc user=$USER format=account,partition,qos
SBATCH_ACCOUNT=
# QoS.                     확인: 위 명령의 qos 열
SBATCH_QOS=
# GPU 요청. 서버에 따라 gpu:1, gpu:a100:1 등.   확인: sinfo -o "%P %G"
SBATCH_GRES=gpu:1
# 작업 하나의 최대 시간 (시:분:초). 파티션 한도 이하.   확인: sinfo -o "%P %l"
# 학습 1회는 로컬 RTX 4070 Ti에서 3~3.6시간이었다. 한도가 짧으면 다음 작업으로 이어서 학습한다.
SBATCH_TIME=
# CPU 수와 메모리. 데이터 로더 worker가 2개다.
SBATCH_CPUS=4
SBATCH_MEM=32G
# 그 밖에 붙일 sbatch 옵션 (예: --constraint=a100). 공백으로 구분한다.
SBATCH_EXTRA=

# ── 이어서 학습 ──────────────────────────────────────
# 한 학습에서 이어서 제출하는 작업 수의 상한 (첫 작업 포함).
CHAIN_MAX=10
